{
  "name": "@workspace/core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:place-order": "node --conditions=react-server --import tsx scripts/check-place-order.ts",
    "check:order-status": "node --conditions=react-server --import tsx scripts/check-order-status.ts",
    "check:payments": "node --conditions=react-server --import tsx scripts/check-payments.ts",
    "check": "pnpm check:place-order && pnpm check:order-status && pnpm check:payments"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "18.0.4",
    "eslint": "^9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
