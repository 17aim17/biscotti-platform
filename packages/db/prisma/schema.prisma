generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions
// - Money is stored in integer paise (₹1 = 100 paise). Tax is in basis points (500 = 5%).
// - Tables and columns are snake_case in Postgres, camelCase in TypeScript.
// - Menu data is archived (archived_at), never deleted, because orders reference it.

// A restaurant brand. The tenant: everything below belongs to one restaurant.
model Restaurant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  // URL segment: /casa-spezia, /casa-spezia/kitchen, /casa-spezia/dashboard
  slug         String   @unique
  // Brand colors, e.g. { "primary": "#8a2b0e" }
  theme        Json     @default("{}")
  logoPath     String?  @map("logo_path")
  // Legal pages: { "about": "...", "privacy": "...", "refund": "...", "terms": "..." }
  legal        Json     @default("{}")
  gstin        String?
  fssaiLicense String?  @map("fssai_license")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  locations   Location[]
  categories  Category[]
  menuItems   MenuItem[]
  memberships Membership[]
  orders      Order[]

  @@map("restaurants")
}

// An outlet of a restaurant, with its own hours, delivery area, fees and tax.
model Location {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId      String   @map("restaurant_id") @db.Uuid
  name              String
  address           String
  lat               Float
  lng               Float
  deliveryRadiusM   Int      @default(5000) @map("delivery_radius_m")
  // Weekly opening hours in Asia/Kolkata: { "mon": [["10:00", "22:30"]], ... }
  hours             Json     @default("{}")
  // Manual switch, e.g. to close early. Hours still apply when true.
  isOpen            Boolean  @default(true) @map("is_open")
  deliveryFeePaise  Int      @default(0) @map("delivery_fee_paise")
  packagingFeePaise Int      @default(0) @map("packaging_fee_paise")
  taxBps            Int      @default(500) @map("tax_bps")
  acceptsCod        Boolean  @default(true) @map("accepts_cod")
  acceptsPickup     Boolean  @default(true) @map("accepts_pickup")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId])
  @@map("locations")
}

model Category {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  sort         Int       @default(0)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  categoryId   String    @map("category_id") @db.Uuid
  title        String
  description  String    @default("")
  pricePaise   Int       @map("price_paise")
  isVeg        Boolean   @map("is_veg")
  imageUrl     String?   @map("image_url")
  // Quick "sold out" toggle for the whole restaurant.
  isAvailable  Boolean   @default(true) @map("is_available")
  // Shown in the storefront's "Signatures" row.
  isFeatured   Boolean   @default(false) @map("is_featured")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([restaurantId, categoryId])
  @@map("menu_items")
}

// One row per Supabase Auth user (id = auth.users.id), created by a trigger on sign-up.
model Profile {
  id        String   @id @db.Uuid
  name      String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships Membership[]
  orders      Order[]

  @@map("profiles")
}

enum MembershipRole {
  owner
  manager
  staff

  @@map("membership_role")
}

// Who works at which restaurant, and in what role. Customers have no rows here.
model Membership {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  role         MembershipRole
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user       Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("memberships")
}

// Allowed transitions are defined in one place: packages/core (orders/status).
enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  CANCELLED

  @@map("order_status")
}

enum Fulfillment {
  delivery
  pickup

  @@map("fulfillment")
}

enum PaymentMethod {
  online
  cod

  @@map("payment_method")
}

model Order {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Human-friendly number shown to customers and the kitchen, e.g. #1042.
  number            Int           @unique @default(autoincrement())
  restaurantId      String        @map("restaurant_id") @db.Uuid
  locationId        String        @map("location_id") @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  status            OrderStatus   @default(PENDING_PAYMENT)
  fulfillment       Fulfillment
  paymentMethod     PaymentMethod @map("payment_method")
  // Snapshots taken when the order is placed.
  customerName      String        @map("customer_name")
  customerPhone     String        @map("customer_phone")
  // { "line1": "...", "landmark": "...", "lat": 30.7, "lng": 76.7 } for delivery, null for pickup.
  deliveryAddress   Json?         @map("delivery_address")
  // Totals computed on the server when the order is placed.
  subtotalPaise     Int           @map("subtotal_paise")
  deliveryFeePaise  Int           @map("delivery_fee_paise")
  packagingFeePaise Int           @map("packaging_fee_paise")
  taxPaise          Int           @map("tax_paise")
  totalPaise        Int           @map("total_paise")
  // Generated by the browser per checkout attempt, so a double submit creates one order.
  idempotencyKey    String        @map("idempotency_key")
  acceptedAt        DateTime?     @map("accepted_at") @db.Timestamptz(6)
  readyAt           DateTime?     @map("ready_at") @db.Timestamptz(6)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?       @map("cancel_reason")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customer   Profile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  payments   Payment[]

  @@unique([customerId, idempotencyKey])
  @@index([restaurantId, status, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("orders")
}

// A line on an order. Title and price are copied so later menu edits never change past orders.
model OrderItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  menuItemId     String @map("menu_item_id") @db.Uuid
  title          String
  unitPricePaise Int    @map("unit_price_paise")
  qty            Int
  lineTotalPaise Int    @map("line_total_paise")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

enum PaymentStatus {
  created
  captured
  failed
  // Paid for an order that was rejected or cancelled. The owner refunds it in Razorpay.
  needs_refund
  refunded

  @@map("payment_status")
}

// One row per Razorpay order. "Retry payment" creates a new row for the same order.
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  // Unique, so the client callback and the webhook cannot record the same payment twice.
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  status            PaymentStatus @default(created)
  amountPaise       Int           @map("amount_paise")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}
