# Copy to .env at the repo root and fill in. Never commit .env.
# Local Supabase values come from: pnpm supabase status

# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server only, bypasses Row Level Security)
SUPABASE_SECRET_KEY=

# Postgres for Prisma. Locally both point at the same database.
# In production: DATABASE_URL = pooled connection, DIRECT_URL = direct connection (migrations).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Razorpay (test mode keys from the Razorpay dashboard)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS: "console" logs messages instead of sending them
SMS_PROVIDER=console
